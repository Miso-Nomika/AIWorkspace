{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AIWorkspace",
  "mainBinaryName": "AIWorkspace",
  "version": "0.21.4",
  "identifier": "com.aiworkspace.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "AIWorkspace",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "zoomHotkeysEnabled": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "AIWorkspace",
    "shortDescription": "AI 에이전트와 함께 쓰는 개발 워크스페이스",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": ["libayatana-appindicator3-1"] }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFMjM5MTQ5NzI2N0Y4RDkKUldUWitHZHlTWkVqdnBuRGpVRDJPNWFOOTRRZ2M4NkhKRU5leU5yb0lJR1gvcEMzc0NrMkdjTVQK",
      "endpoints": ["https://github.com/Miso-Nomika/AIWorkspace/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
