{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "메인 창 권한: 기본 + 폴더 선택·확인 대화상자 + 자동 업데이트(확인·설치·재시작) + 전체화면. 앱 자체 명령(data_*, 프로젝트 파일)은 Rust에서 검증한다.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen"
  ]
}
